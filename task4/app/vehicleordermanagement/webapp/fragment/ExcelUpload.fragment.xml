<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Dialog
        id="excelUploadDialog"
        title="Upload Vehicle Excel"
        contentWidth="500px"
        draggable="true"
        resizable="true">

        <content>
            <VBox class="sapUiMediumMargin">

                <Text
                    text="Select an Excel file (.xlsx)"
                    class="sapUiSmallMarginBottom" />

                <u:FileUploader
                    id="excelFileUploader"
                    width="100%"
                    fileType="xlsx"
                    placeholder="Choose Excel file"
                    change=".onExcelFileChange" />

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Upload"
                type="Emphasized"
                press=".onExcelUploadSave" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onExcelUploadCancel" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>