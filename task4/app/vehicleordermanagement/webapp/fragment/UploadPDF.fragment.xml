
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Dialog
        id="uploadPDFDialog"
        title="Upload Vehicle PDF"
        contentWidth="500px"
        draggable="true"
        resizable="true">

        <content>

            <VBox
                class="sapUiMediumMargin">

                <Label
                    text="Select PDF"
                    labelFor="pdfUploader" />

                <u:FileUploader
                    id="pdfUploader"
                    width="100%"
                    fileType="pdf"
                    mimeType="application/pdf"
                    change=".onPDFSelected"
                    placeholder="Choose PDF file" />

                <Text
                    id="selectedPDFText"
                    text="No PDF selected"
                    class="sapUiSmallMarginTop" />

            </VBox>

        </content>

        <beginButton>

            <Button
                text="Upload"
                type="Emphasized"
                press=".onPDFUpload" />

        </beginButton>

        <endButton>

            <Button
                text="Cancel"
                press=".onPDFDialogCancel" />

        </endButton>

    </Dialog>

</core:FragmentDefinition>
