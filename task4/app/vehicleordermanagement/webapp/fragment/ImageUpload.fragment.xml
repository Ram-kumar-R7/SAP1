<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Dialog
        id="imageUploadDialog"
        title="Upload Vehicle Image"
        contentWidth="450px"
        draggable="true"
        resizable="true">

        <content>

            <VBox class="sapUiMediumMargin">

                <Text
                    text="Select a JPG or PNG image. Maximum size: 5 MB."
                    class="sapUiSmallMarginBottom" />

                <u:FileUploader
                    id="vehicleImageUploader"
                    width="100%"
                    buttonText="Choose Image"
                    fileType="jpg,jpeg,png"
                    mimeType="image/jpeg,image/png"
                    change=".onImageFileChange" />

                <Text
                    id="imageErrorText"
                    visible="false"
                    class="sapUiTinyMarginTop sapUiSmallMarginBottom" />

                <Image
                    id="imagePreview"
                    width="400px"
                    height="250px"
                    visible="false"
                    densityAware="false"
                    decorative="false"
                    class="sapUiSmallMarginTop" />

            </VBox>

        </content>

        <beginButton>

            <Button
                text="Upload"
                type="Emphasized"
                icon="sap-icon://upload"
                enabled="false"
                press=".onImageUploadSave" />

        </beginButton>

        <endButton>

            <Button
                text="Cancel"
                press=".onImageUploadCancel" />

        </endButton>

    </Dialog>

</core:FragmentDefinition>

